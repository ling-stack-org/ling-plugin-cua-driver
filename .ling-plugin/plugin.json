{
  "id": "official:cua-driver",
  "displayName": "Cua Driver",
  "version": "0.2.0",
  "lingInterfaceVersion": "2",
  "sourceKind": "official-remote",
  "trustLevel": "official",
  "description": "Adds the Cua Driver provider for native computer control in Ling Desktop.",
  "trustSummary": "Uses Ling Desktop's operating-system permissions, interactive session, tool approvals and process leases.",
  "platforms": [
    "darwin",
    "win32"
  ],
  "contributions": [
    {
      "kind": "mcp-server",
      "id": "mcp:cua-driver",
      "path": "./mcp-server.json"
    }
  ],
  "healthChecks": [
    {
      "id": "manifest",
      "kind": "descriptor",
      "label": "Bundled plugin manifest"
    },
    {
      "id": "binary",
      "kind": "binary",
      "label": "cua-driver binary"
    },
    {
      "id": "mcp",
      "kind": "mcp",
      "label": "Cua Driver MCP server"
    }
  ],
  "defaultApprovals": [
    {
      "contributionId": "mcp:cua-driver",
      "decision": "ask",
      "reason": "GUI automation and screen access require explicit approval."
    }
  ],
  "manifestVersion": 2
}
